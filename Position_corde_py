def longueur(Xa,Za):
    #programme pour calculer la longueur de corde enroulée et déroulée
    alpha_2 = np.arctan(d2/Xa)
    beta_2 = np.arctan(d2/Za)
    L_min = np.sqrt( (d1/np.tan(alpha_c))**2 + d1**2 + (d1/np.tan(beta_c)**2) )
    L_max = np.sqrt( (d2/np.tan(alpha_2))**2 + d2**2 + (d2/np.tan(beta_2)**2) )
    
    return L_min,L_max
   
