""" Alogorithme pour déterminer la longueur des cordes
et la position des accroches"""

""" Bibliothèques """
import numpy as np
import matplotlib.pyplot as plt

""" Données d'entrée """
d1 = 0.95 #en m longueur de la corde en projection sur y en position haute
d2 = 4.75 #en m longueur de la corde en projection sur y en position basse

alpha_c = 30*(2*np.pi/360) #choix de l'angle critique en projection sur xy

#Constantes propres à l'ellipse du dirigeable
a = 2.5
b = 3.5
c = 0.75

#Position des quatres arceaux 
xa = 0.15
za = 0.05
xb = -0.15
zb = 0.05
xc = -0.15
zc = -0.05
xd = 0.15
zd = -0.05


x = d1/np.tan(alpha_c) #position de l'accroche

""" Programmes """

def ellipse(x):
    #Renvoie la valeur de z pour un x donné sur la courbe de l'éllipse du dirigeable
    if x >= 0:
        return c * np.sqrt(1 - ((x/b)**2))

    else :
        return c * np.sqrt(1 - ((x/a)**2))

    
def test_ellipse():
    #comme son nom l'indique
    x = np.linspace(-15,15,30000)
    z = [ellipse(k) for k in x]
    z2 = [-ellipse(k) for k in x]
    #plt.title("Test de l'éllipse2")
    plt.plot(x,z,'r-')
    plt.plot(x,z2,'r-')
    
    #plt.grid()
    #plt.show()

""" Alogorithme """
# Choisir alpha critique
# calculer x
# choisir z pour être sur la paroi du dirigeable
# cacluler beta critique
# vérifier beta critique
# calcul de Lx et lz
# calcul de L

z = ellipse(x)

beta_c = np.arctan(d1/z)

def f(x0):
    #x0 position de l'arceau
    alpha_c = 30*(2*np.pi/360)
    if x0 > 0:
        x = x0 + d1/np.tan(alpha_c)
    
    
        z = ellipse(x)
        beta_c = np.arctan(d1/z)
    
        while (360/(2*np.pi)) * abs((alpha_c-beta_c)) > 0.0001:
            alpha_c = alpha_c + 0.0001*(2*np.pi/360)
            x = x0 + d1/np.tan(alpha_c)
            z = ellipse(x)
            beta_c = np.arctan(d1/z)
    
    else:
        x = x0 - d1/np.tan(alpha_c)
        
        z = ellipse(x)
        beta_c = np.arctan(d1/z)
    
        while (360/(2*np.pi)) * abs((alpha_c-beta_c)) > 0.0001:
            alpha_c = alpha_c + 0.0001*(2*np.pi/360)
            x = x0 - d1/np.tan(alpha_c)
            z = ellipse(x)
            beta_c = np.arctan(d1/z)
    
    return x,z,alpha_c,beta_c

